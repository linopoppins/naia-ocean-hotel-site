---
layout: base.njk
title: "Rooms & Rates — Naia Ocean Hotel · Midigama, Sri Lanka"
description: "Six rooms at Naia Ocean Hotel in Midigama, Sri Lanka — sea view doubles, garden doubles and twin rooms. Each with a private kitchenette, private bathroom and terrace, steps from Midigama beach."
ogTitle: "Rooms & Rates, Naia Ocean Hotel"
ogDescription: "Six rooms at Naia Ocean Hotel — sea view doubles, garden doubles and twin rooms. Each with a private kitchenette, private bathroom and terrace, steps from Midigama beach."
ogImage: "https://naia-ocean-hotel.example/assets/images/rooms-hero.webp"
activePage: "rooms"
screenLabel: "Rooms"
showCurrency: true
extraHead: |
  <style>
    .roomfull{padding-block:clamp(3rem,5vw,5rem);border-bottom:1px solid var(--line-soft)}
    .roomfull:last-of-type{border-bottom:none}
    .roomgal{display:grid;grid-template-columns:2fr 1fr;grid-template-rows:1fr 1fr;gap:12px;aspect-ratio:4/3}
    .roomgal img{width:100%;height:100%;object-fit:cover;display:block;cursor:zoom-in}
    .roomgal .rg-main{grid-row:span 2}
    .roomfull__info h2{font-size:var(--t-h2);margin-top:.6rem}
    .roomfull__price{display:flex;align-items:baseline;gap:.5rem;margin:1rem 0 .2rem}
    .roomfull__price .num{font-family:var(--serif);font-size:2.6rem;color:var(--terracotta);line-height:1}
    .roomfull__cap{display:inline-flex;align-items:center;gap:.5rem;font-size:.9rem;color:var(--ink-soft);margin-bottom:1rem}
    .roomfull__cap svg{width:16px;height:16px;color:var(--leaf)}
    .amenrow{display:flex;flex-wrap:wrap;gap:.6rem;margin:1.4rem 0 1.8rem}
    .filterbar{display:flex;flex-wrap:wrap;gap:.6rem;justify-content:center;margin-top:2rem}
    .filterbar button{padding:.7rem 1.3rem;border-radius:100px;font-size:.85rem;font-weight:500;
      letter-spacing:.03em;color:var(--ink-soft);background:#fff;box-shadow:inset 0 0 0 1.5px var(--line);transition:.35s var(--ease)}
    .filterbar button:hover{box-shadow:inset 0 0 0 1.5px var(--ocean);color:var(--ocean)}
    .filterbar button.is-active{background:var(--ocean);color:#fff;box-shadow:none}
    .incl{background:var(--sand);border-radius:var(--radius-lg);padding:clamp(1.6rem,3vw,2.4rem)}
    @media(max-width:900px){.roomgal{aspect-ratio:16/10}}
    @media(max-width:640px){
      .roomgal{grid-template-columns:1fr;grid-template-rows:auto;aspect-ratio:3/2}
      .roomgal .rg-main{grid-row:auto}
      .roomgal img:not(.rg-main){display:none}
      .roomfull__price .num{font-size:2rem}
      .incl .split{gap:1.5rem}
    }
  </style>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "https://naia-ocean-hotel.example/index.html"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Rooms",
        "item": "https://naia-ocean-hotel.example/rooms.html"
      }
    ]
  }
  </script>
permalink: "/rooms.html"
heroTitle: "Rooms & rates"
heroSubtitle: "Six rooms in Midigama, Sri Lanka, each with its own light and mood."
---


<!-- PAGE HERO -->
<section class="pagehero">
  <div class="pagehero__media"><img src="assets/images/rooms-hero.webp" alt="Naia Ocean Hotel, Midigama" fetchpriority="high"></div>
  <div class="pagehero__inner">
    <p class="crumb"><a href="index.html" data-i18n="nav.home">Home</a> &middot; <span data-i18n="nav.rooms">Rooms</span></p>
    <h1 data-i18n="rooms.hero.title">{{ heroTitle | safe }}</h1>
    <p class="pagehero__sub">{{ heroSubtitle }}</p>
  </div>
</section>

<!-- FILTER -->
<section class="section" style="padding-bottom:0">
  <div class="wrap">
    <div class="filterbar" data-filter-bar>
      <button class="is-active" data-filter="all">All rooms</button>
      <button data-filter="seaview">Sea view</button>
      <button data-filter="double">Double bed</button>
      <button data-filter="twin">Twin beds</button>
    </div>
  </div>
</section>

