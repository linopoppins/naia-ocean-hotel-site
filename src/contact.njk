<!-- CONTACT + INFO -->
<section class="section">
  <div class="wrap">
    <div class="contact-grid">
      <div class="reveal">
        <h2 class="title-h3" data-i18n="contact.form.title">Send us a message</h2>
        <div class="ok mt-3" data-contact-ok>
          <b>Message sent, thank you.</b>
          <span>We usually reply within a few hours. Talk soon.</span>
        </div>
        <form data-contact class="mt-3" novalidate>
          <div class="field-row">
            <div class="field"><label data-i18n="contact.field.name">Your name</label><input type="text" name="name" required></div>
            <div class="field"><label data-i18n="contact.field.email">Email</label><input type="email" name="email" required></div>
          </div>
          <div class="field"><label data-i18n="contact.field.subject">Subject</label><input type="text" name="subject"></div>
          <div class="field"><label data-i18n="contact.field.message">Message</label><textarea name="message" rows="5" required></textarea></div>
          <button type="submit" class="btn btn--primary" data-i18n="cta.sendMsg">Send message</button>
        </form>
      </div>

      <aside class="reveal d1">
        <h2 class="title-h3" data-i18n="contact.info.title">Find us</h2>
        <div class="mt-3">
          <div class="info__row">
            <svg viewBox="0 0 24 24" fill="none"><path d="M12 21s7-6.3 7-11a7 7 0 10-14 0c0 4.7 7 11 7 11z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.6"/></svg>
            <div><b data-i18n="contact.info.address">Address</b><span>Beach Road, Midigama East,<br>Ahangama 80650, Sri Lanka</span></div>
          </div>
          <div class="info__row">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 00-8.6 15l-1.3 4.8 5-1.3A10 10 0 1012 2zm4.4 12.4c-.2-.1-1.4-.7-1.6-.8s-.4-.1-.5.1-.6.8-.8 1-.3.2-.5.1a6.5 6.5 0 01-1.9-1.2 7.2 7.2 0 01-1.3-1.7c-.1-.2 0-.4.1-.5l.4-.4.2-.4v-.4l-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5a.9.9 0 00-.7.3 2.8 2.8 0 00-.9 2.1 4.9 4.9 0 001 2.6 11 11 0 004.3 3.8c.6.3 1.1.4 1.5.5a3.6 3.6 0 001.6.1 2.7 2.7 0 001.8-1.3 2.2 2.2 0 00.2-1.3c-.1-.1-.3-.2-.5-.3z"/></svg>
            <div><b data-i18n="contact.info.phone">Phone / WhatsApp</b><span><a href="#" data-wa>+94 77 000 0000</a></span></div>
          </div>
          <div class="info__row">
            <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.6"/><path d="M4 7l8 6 8-6" stroke="currentColor" stroke-width="1.6"/></svg>
            <div><b data-i18n="contact.info.email">Email</b><span><a href="mailto:hello@naiaocean.com">hello@naiaocean.com</a></span></div>
          </div>
          <div class="info__row">
            <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M12 7v5l3 2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
            <div><b data-i18n="contact.info.hours">Reception</b><span data-i18n="contact.info.hoursval">Every day · 7:00 – 21:00</span></div>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>

<!-- MAP -->
<section class="section" style="padding-top:0">
  <div class="wrap">
    <div class="mapwrap reveal">
      <iframe title="Map of Naia Ocean Hotel, Midigama" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
        src="https://www.google.com/maps?q=Midigama,Sri+Lanka&z=13&output=embed"></iframe>
    </div>
  </div>
</section>

<!-- GETTING HERE -->
<section class="section section--sand">
  <div class="wrap">
    <div class="sec-head reveal">
      <p class="eyebrow" data-i18n="contact.getting.eyebrow">Getting here</p>
      <h2 data-i18n="contact.getting.title">From the airport to the front door.</h2>
    </div>
    <div class="steps mt-4">
      <article class="step reveal">
        <div class="step__n">01</div>
        <h3 data-i18n="contact.step.1.title">Fly into Colombo (CMB)</h3>
        <p data-i18n="contact.step.1.desc">Bandaranaike International is the country's main gateway, about 160 km north of Midigama.</p>
      </article>
      <article class="step reveal d1">
        <div class="step__n">02</div>
        <h3 data-i18n="contact.step.2.title">Drive the southern expressway</h3>
        <p data-i18n="contact.step.2.desc">The E01 highway runs straight down the coast, roughly 2.5 hours by car.</p>
      </article>
      <article class="step reveal d2">
        <div class="step__n">03</div>
        <h3 data-i18n="contact.step.3.title">Or take the coastal train</h3>
        <p data-i18n="contact.step.3.desc">One of the most beautiful train rides in the world hugs the coast to Midigama station.</p>
      </article>
    </div>
    <div class="mt-4 reveal"><a href="#" data-wa class="btn btn--primary" data-i18n="contact.transfer">Arrange an airport transfer</a></div>
  </div>
</section>

