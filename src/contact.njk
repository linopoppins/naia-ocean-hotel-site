<section class="pagehero" style="min-height:46vh">
  <div class="pagehero__media"><image-slot fetchpriority="high" alt="Coastline, the house from the road" id="contact-hero" src="https://images.unsplash.com/photo-1592669250175-385cd3d83fb7?fm=webp&amp;q=75&amp;w=1800&amp;auto=format&amp;fit=crop" placeholder="Coastline / the house from the road" fit="cover"></image-slot></div>
