<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="https://naia-ocean-hotel.example/{{ activePage }}.html">
<link rel="icon" href="assets/images/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="assets/images/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="assets/images/favicon-16x16.png">
<link rel="apple-touch-icon" href="assets/images/apple-touch-icon.png">

<meta property="og:title" content="{{ ogTitle or title }}">
<meta property="og:description" content="{{ ogDescription or description }}">
<meta property="og:type" content="website">
<meta property="og:url" content="https://naia-ocean-hotel.example/{{ activePage }}.html">
<meta property="og:site_name" content="Naia Ocean Hotel">
<meta property="og:locale" content="en_US">
<meta property="og:image" content="{{ ogImage }}">
<meta property="og:image:alt" content="{{ title }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ ogImage }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400;1,500&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=Dancing+Script:wght@500;600&display=swap">
<link rel="preconnect" href="https://open.er-api.com">
<link rel="stylesheet" href="assets/styles.css">
{% if extraHead %}{{ extraHead | safe }}{% endif %}
</head>
<body>

{% include "nav.njk" %}

{{ content | safe }}

{% include "footer.njk" %}
</body>
</html>
